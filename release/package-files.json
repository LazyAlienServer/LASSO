    {"source": "scripts/release_version.py", "target": "scripts/release_version.py", "render": false},
    {"source": "scripts/release_layout.py", "target": "scripts/release_layout.py", "render": false},
    {"source": "scripts/build_docker_image.py", "target": "scripts/build_docker_image.py", "render": false},
