# Replace the hostname/certificate paths, install the full forwarding include and verify with nginx -t.
server {
    listen 80 default_server;
    server_name _;
    return 421;
}
server {
    listen 80;
    server_name auth.example.com;
    return 308 https://auth.example.com$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/las-sso/tls/fullchain.pem;
    ssl_certificate_key /etc/las-sso/tls/privkey.pem;
    return 421;
}
server {
    listen 443 ssl;
    server_name auth.example.com;
    ssl_certificate /etc/las-sso/tls/fullchain.pem;
    ssl_certificate_key /etc/las-sso/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location /actuator/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        include /etc/nginx/snippets/las-sso-forwarding.conf;
    }
}
