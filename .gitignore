.idea/
.dide/
build/
hs_err_pid*
replay_pid*

# Local tooling and generated exports; preserve the files locally.
.gradle/
.build*/
bin/
target/
logs/
*.log
*.iml
/docs.zip
**/codex-build.init.gradle
**/*.local.init.gradle

# External settings and key material must not enter source control.
.local/
.env
.env.*
!.env.example
*.p12
*.pfx
*.jks
*.keystore
*.key
*.pem

# Deployment copies and credentials: templates ending in .example remain trackable.
secrets/
.private/
deployment.env
deployment.*.env
restore.env
server.properties
monitoring.properties
queue-maintenance.properties
bff.properties
durable-revocation.properties
credentials.txt
LOCAL-ADMIN-CREDENTIALS.txt
private-state*.json
*-private-state.json
storage-state*.json
*-storage-state.json
storageState*.json

# Runtime backups, authentication captures, heap dumps and exported images.
backups/
dumps/
*.dump
*.pgdump
*.backup
*.sql.gz
*.sql.zst
*.har
*.hprof
*.tar
*.tar.gz
*.tgz
*.zip
playwright-report/
test-results/

# Application binaries are release assets, not source; retain the build bootstrap JAR.
*.class
*.jar
*.war
*.ear
!**/gradle/wrapper/gradle-wrapper.jar

# Python verification tools.
__pycache__/
*.py[cod]
node_modules/

# Generated versioned deliveries; keep their templates and packaging tools tracked.
/release/[0-9]*.*/
/release/las-sso-*.zip
