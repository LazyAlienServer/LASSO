LAS_SSO_HTTP_PORT=80
LAS_SSO_HTTPS_PORT=443
LAS_SSO_APP_PORT=19000
LAS_SSO_CONFIG_DIR=
LAS_SSO_SECRET_DIR=
LAS_SSO_KEY_PATH=
LAS_SSO_MEMORY_LIMIT=
LAS_SSO_CPUS=
LAS_SSO_DB_MEMORY_LIMIT=
LAS_SSO_DB_CPUS=
