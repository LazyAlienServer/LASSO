# Host-installed Nginx: SSO/PostgreSQL Compose only. No real secret values here.
# Keep the existing project name when adapting an existing database volume.
LAS_SSO_PROJECT=las-sso-preproduction
LAS_SSO_IMAGE=
LAS_SSO_DB_IMAGE=
LAS_SSO_HOST=
LAS_SSO_ISSUER=
LAS_SSO_SIGNING_KEY_ALIAS=
